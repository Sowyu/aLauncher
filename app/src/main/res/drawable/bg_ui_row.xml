<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable rounded row on a plum surface (picker "Clear slot", favourites rows) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ui_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</ripple>
