<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Rounded pill buttons shown while editing the home list; same look as the drawer search pill -->
    <style name="HomeEditPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_drawer_search</item>
        <item name="android:textColor">@color/home_edit_pill_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/google_sans_flex_medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
