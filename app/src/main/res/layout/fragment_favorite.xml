<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:fitsSystemWindows="true"
    tools:context=".ui.FavoriteFragment">

    <LinearLayout
        android:id="@+id/pageLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        tools:ignore="UselessParent">

        <!-- Same large title as the settings screens -->
        <com.github.creativecodecat.components.views.FontAppCompatTextView
            android:id="@+id/pageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            android:accessibilityHeading="true"
            android:text="@string/favorite_apps"
            android:textColor="@color/ui_text"
            android:textSize="34sp" />

        <!-- Tap a row to pick its app, drag to reorder -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeAppsRecyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_favorite_app" />

        <LinearLayout
            android:id="@+id/addRemoveAppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeAppButton"
                style="@style/Widget.ALauncher.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remove_app" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addAppButton"
                style="@style/Widget.ALauncher.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/add_app" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
