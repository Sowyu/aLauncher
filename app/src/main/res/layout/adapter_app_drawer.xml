<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:animateLayoutChanges="true">

    <FrameLayout
        android:id="@+id/appTitleFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.github.creativecodecat.components.views.FontAppCompatTextView
            android:id="@+id/appTitle"
            style="@style/TextLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingHorizontal="24dp"
            android:paddingVertical="@dimen/app_padding_vertical"
            android:text="@string/select_app" />

    </FrameLayout>

    <!-- Inline rename: rounded field (clear = cancel) and a Done pill, in place of the row -->
    <LinearLayout
        android:id="@+id/appRenameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout style="@style/ALauncher.InlineField">

            <com.github.creativecodecat.components.views.FontEditText
                android:id="@+id/appRenameEdit"
                style="@style/ALauncher.InlineField.Edit"
                android:autofillHints="name"
                tools:ignore="LabelFor" />

            <ImageView
                android:id="@+id/appSaveCancel"
                style="@style/ALauncher.InlineField.Clear"
                android:contentDescription="@string/cancel" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appSaveRename"
            style="@style/Widget.ALauncher.Button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:minHeight="52dp"
            android:paddingHorizontal="20dp"
            android:text="@string/st_done" />
    </LinearLayout>

    <!-- Inline tag: same field and pill -->
    <LinearLayout
        android:id="@+id/appTagLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout style="@style/ALauncher.InlineField">

            <com.github.creativecodecat.components.views.FontEditText
                android:id="@+id/appTagEdit"
                style="@style/ALauncher.InlineField.Edit"
                android:autofillHints="name"
                tools:ignore="LabelFor" />

            <ImageView
                android:id="@+id/appTagCancel"
                style="@style/ALauncher.InlineField.Clear"
                android:contentDescription="@string/cancel" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/appSaveTag"
            style="@style/Widget.ALauncher.Button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:minHeight="52dp"
            android:paddingHorizontal="20dp"
            android:text="@string/st_done" />
    </LinearLayout>

</FrameLayout>
