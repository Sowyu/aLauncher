<?xml version="1.0" encoding="utf-8"?>
<!-- Root takes over upward drags to pull the app drawer up with the finger -->
<com.github.codeworkscreativehub.mlauncher.ui.components.VerticalDragLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.HomeFragment">

<FrameLayout
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/touchArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="50dp" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/mainView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="20dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/timeDateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="1dp"
                android:orientation="vertical"
                tools:visibility="visible">

                <com.github.creativecodecat.components.views.FontTextClock
                    android:id="@+id/clock"
                    style="@style/TextDefaultStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/time_size"
                    tools:text="02:34" />


                <com.github.creativecodecat.components.views.FontTextClock
                    android:id="@+id/date"
                    style="@style/TextDefaultStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:textSize="@dimen/date_size"
                    tools:text="Thu, 30 Dec" />
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- First run tips -->
        <LinearLayout
            android:id="@+id/firstRunTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="4dp"
            android:layout_marginTop="106dp"
            android:layout_marginEnd="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.github.creativecodecat.components.views.FontAppCompatTextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/swipe_up_for_apps" />

            <com.github.creativecodecat.components.views.FontAppCompatTextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/long_press_for_settings" />

        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>


    <!-- Home apps-->
    <com.github.codeworkscreativehub.mlauncher.ui.components.ReorderableLinearLayout
        android:id="@+id/homeAppsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="100dp"
        android:paddingBottom="30dp" />

    <com.github.creativecodecat.components.views.FontAppCompatTextView
        android:id="@+id/homeScreenPager"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:visibility="gone" />

    <!-- Set default launcher -->
    <com.github.creativecodecat.components.views.FontAppCompatTextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/advanced_settings_set_as_default_launcher"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fabPhone"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/ic_phone" />

        <ImageView
            android:id="@+id/fabMessages"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/ic_messages" />

        <ImageView
            android:id="@+id/fabCamera"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/ic_camera" />

        <ImageView
            android:id="@+id/fabPhotos"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/ic_photos" />

        <ImageView
            android:id="@+id/fabBrowser"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/ic_browser" />

        <ImageView
            android:id="@+id/fabSettings"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/ic_settings" />

        <ImageView
            android:id="@+id/fabAction"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/app_launcher" />

    </LinearLayout>

    <!-- Edit mode (long-press empty space): Settings and Done -->
    <LinearLayout
        android:id="@+id/editBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:alpha="0"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/editSettings"
            style="@style/HomeEditPill"
            android:text="@string/home_edit_settings" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/editDone"
            style="@style/HomeEditPill"
            android:text="@string/home_edit_done" />
    </LinearLayout>

</FrameLayout>

<!-- App drawer overlay, hosted here so it can follow the finger -->
<androidx.fragment.app.FragmentContainerView
    android:id="@+id/drawerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="invisible" />

</com.github.codeworkscreativehub.mlauncher.ui.components.VerticalDragLayout>
