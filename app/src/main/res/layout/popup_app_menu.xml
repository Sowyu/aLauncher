<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press menu for an app row; positioned and filled by AppContextMenu -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appMenuCard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_app_menu"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="false"
    android:minWidth="232dp"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/appMenuIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <com.github.creativecodecat.components.views.FontAppCompatTextView
                android:id="@+id/appMenuName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/app_menu_text"
                android:textSize="16sp"
                tools:text="AntiSplit M" />

            <com.github.creativecodecat.components.views.FontAppCompatTextView
                android:id="@+id/appMenuSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="middle"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:textColor="@color/app_menu_text_secondary"
                android:textSize="13sp"
                tools:text="com.abdurazaaqmohammed.AntiSplit" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/appMenuActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
