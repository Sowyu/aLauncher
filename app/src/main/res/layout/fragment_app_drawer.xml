<?xml version="1.0" encoding="utf-8"?>
<com.github.codeworkscreativehub.mlauncher.ui.components.VerticalDragLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fixed backdrop: blurred wallpaper copy + scrim. Fades with the drawer, never moves. -->
    <FrameLayout
        android:id="@+id/drawerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/drawerBlur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/drawerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/drawer_scrim_solid" />
    </FrameLayout>

    <!--
        The sliding panel. The list fills it edge to edge and scrolls under the status bar and
        under the search pill; its paddings (set from insets in code) keep the first and last
        rows clear of both. No fading edges, no hard clip lines.
    -->
    <FrameLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <com.github.creativecodecat.components.views.FontRecyclerView
            android:id="@+id/appsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:saveEnabled="false"
            android:scrollbars="none" />

        <FrameLayout
            android:id="@+id/sidebar_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginHorizontal="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:visibility="gone">

            <com.github.codeworkscreativehub.mlauncher.ui.components.AZSidebarView
                android:id="@+id/azSidebar"
                android:layout_width="32dp"
                android:layout_height="match_parent" />
        </FrameLayout>

        <com.github.creativecodecat.components.views.FontAppCompatTextView
            android:id="@+id/listEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/drawer_list_empty_hint"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical">

            <com.github.creativecodecat.components.views.FontAppCompatTextView
                android:id="@+id/appDrawerTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_drawer_tips"
                android:textColor="?attr/primaryColor"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Picker modes only: "Choose an app" / "Hidden apps" -->
            <com.github.creativecodecat.components.views.FontAppCompatTextView
                android:id="@+id/pickerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:accessibilityHeading="true"
                android:maxLines="2"
                android:textColor="@color/ui_text"
                android:textSize="32sp"
                android:visibility="gone" />

            <com.github.creativecodecat.components.views.FontAppCompatTextView
                android:id="@+id/clearHomeButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="8dp"
                android:background="@drawable/bg_ui_row"
                android:drawablePadding="16dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:text="@string/picker_clear_slot"
                android:textColor="@color/ui_text"
                android:textSize="17sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_close"
                app:drawableTint="@color/ui_accent" />
        </LinearLayout>

        <!-- Search sits at the bottom, in thumb reach, and rides on top of the keyboard -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <com.github.creativecodecat.components.views.FontSearchView
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:paddingHorizontal="0dp"
                android:paddingVertical="0dp"
                app:closeIcon="@drawable/ic_close"
                app:iconifiedByDefault="false"
                app:queryBackground="@null"
                app:queryHint="___"
                app:searchIcon="@drawable/ic_search"
                app:theme="@style/AppSearchText" />

            <ImageView
                android:id="@+id/workApps"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/show_work_apps"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:srcCompat="@drawable/work_profile" />

            <ImageView
                android:id="@+id/systemApps"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/show_apps"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:srcCompat="@drawable/system_profile" />

            <ImageView
                android:id="@+id/internetSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/search_engine"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_browser" />
        </LinearLayout>
    </FrameLayout>
</com.github.codeworkscreativehub.mlauncher.ui.components.VerticalDragLayout>
